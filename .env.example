# Copiar a .env.local para desarrollo local
# Generado automáticamente por: npx convex dev

# URL del backend Convex (obligatorio para guardar datos)
VITE_CONVEX_URL=

# Generado por convex dev (no editar manualmente si usas convex dev)
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Solo para agentes en la nube / CI sin login:
# CONVEX_AGENT_MODE=anonymous

# ── Producción (GitHub Actions) ─────────────────────────────
# No pongas secrets aquí. En GitHub:
# Settings → Secrets → Actions → VITE_CONVEX_URL
# Valor: URL de producción tras `npx convex deploy`
# Ejemplo: https://tu-proyecto-123.convex.cloud
